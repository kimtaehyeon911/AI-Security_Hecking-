# vts — Verifiable TradingAgents System
# Copy to `.env` and fill in. NEVER commit `.env` (it is gitignored).

# --- Data (Step 1: backtest data source) ------------------------------------
# Binance klines are PUBLIC — no key needed for backtest/paper data.
# Alpha Vantage (only for the us_equity profile): https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# --- Broker (Step 6: Binance spot) -------------------------------------------
# Create keys at the SPOT TESTNET first: https://testnet.binance.vision
# The adapter defaults to the testnet; production needs base_url=PROD_BASE_URL
# in code AND the live arming token below. NEVER commit these.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Live arming (Step 6). Exact token required; a boolean is deliberately not enough.
# VTS_LIVE_TRADING_ARMED=I_UNDERSTAND_THE_RISK
# Kill switch: any non-empty non-false value liquidates the sleeve and latches.
# VTS_KILL_SWITCH=

# --- LLM (Step 2/3) ----------------------------------------------------------
# Default provider is DeepSeek (cheapest for large backtests). Switch via VTS_* below.
DEEPSEEK_API_KEY=
# Alternatives (only set the one you use):
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- vts runtime overrides (all optional; defaults live in vts/config.py) -----
# VTS_ASSET_CLASS=crypto_spot         # crypto_spot | us_equity | kr_equity
# VTS_DATA_SOURCE=binance             # binance | alpha_vantage
# VTS_UNIVERSE=BTCUSDT,ETHUSDT,SOLUSDT
# VTS_LLM_PROVIDER=deepseek
# VTS_DEEP_THINK_LLM=deepseek-v4-pro
# VTS_QUICK_THINK_LLM=deepseek-v4-flash
# VTS_TEMPERATURE=0.0
# VTS_MONTHLY_BUDGET_USD=30
# VTS_CADENCE=1d                       # 1d | 4h
# VTS_DATA_DIR=~/.vts
