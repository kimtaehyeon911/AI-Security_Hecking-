# vts — Verifiable TradingAgents System
# Copy to `.env` and fill in. NEVER commit `.env` (it is gitignored).

# --- Data (Step 1: backtest data source) ------------------------------------
# Alpha Vantage: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# --- LLM (Step 2/3) ----------------------------------------------------------
# Default provider is DeepSeek (cheapest for large backtests). Switch via VTS_* below.
DEEPSEEK_API_KEY=
# Alternatives (only set the one you use):
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- vts runtime overrides (all optional; defaults live in vts/config.py) -----
# VTS_ASSET_CLASS=us_equity           # us_equity | kr_equity | crypto_spot
# VTS_DATA_SOURCE=alpha_vantage
# VTS_UNIVERSE=AAPL,MSFT,NVDA,AMZN,GOOGL
# VTS_LLM_PROVIDER=deepseek
# VTS_DEEP_THINK_LLM=deepseek-v4-pro
# VTS_QUICK_THINK_LLM=deepseek-v4-flash
# VTS_TEMPERATURE=0.0
# VTS_MONTHLY_BUDGET_USD=30
# VTS_CADENCE=1d                       # 1d | 4h
# VTS_DATA_DIR=~/.vts
