# Go-live gate — editable configuration (sourced by every gate script).
# Copy nothing; just edit values here. All are overridable from your shell env too.

# --- Python / data location --------------------------------------------------
# The project venv created by 00_setup.sh.
: "${VENV:=.venv}"
# Keep state OUTSIDE the repo so *.sqlite/state never get committed (see HANDOVER).
: "${VTS_DATA_DIR:=$HOME/.vts}"
export VTS_DATA_DIR

# --- universe ----------------------------------------------------------------
: "${VTS_UNIVERSE:=BTCUSDT,ETHUSDT,SOLUSDT}"
export VTS_UNIVERSE

# --- decision model ----------------------------------------------------------
# MODEL=momentum      -> deterministic, no LLM/keys/network; harness-only (always
#                        cutoff-exempt = clean). Use to smoke-test the pipeline.
# MODEL=tradingagents -> the real LLM graph (needs the fork installed + LLM key).
: "${MODEL:=tradingagents}"

# VALIDATION track LLM. deepseek-v3 has ~23 months of clean history (effective
# cutoff 2024-09-29). The contamination gate keys on THIS id via VTS_DEEP_THINK_LLM.
: "${VTS_DEEP_THINK_LLM:=deepseek-v3}"
: "${VTS_QUICK_THINK_LLM:=deepseek-v3}"
export VTS_DEEP_THINK_LLM VTS_QUICK_THINK_LLM

# --- windows -----------------------------------------------------------------
# Ingest a little before the backtest start so momentum/indicators have warm-up.
: "${INGEST_START:=2024-08-01}"
# VALIDATION backtest window: MUST start AFTER deepseek-v3's effective cutoff
# (2024-09-29). check_window.py enforces this before the run.
: "${BACKTEST_START:=2024-10-01}"
: "${BACKTEST_END:=2025-06-30}"
: "${INGEST_END:=$BACKTEST_END}"

# Paper window (forward data is definitionally clean). For a real 8-week run you
# instead schedule 30_paper.sh daily; these bounds are for a catch-up backfill.
: "${PAPER_START:=2025-07-01}"
: "${PAPER_END:=2025-08-31}"

# --- testnet smoke -----------------------------------------------------------
: "${LIVE_CAPITAL:=100}"       # checked against the hardcoded 1% cap regardless
